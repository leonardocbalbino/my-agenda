# --- Postgres -----------------------------------------------------------------
# Superusuário: só para pnpm db:setup (papéis, banco, extensões). Nunca na app.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Dono das tabelas: roda migrations e seed. Também sujeito ao RLS (FORCE).
DATABASE_MIGRATOR_URL=postgres://marcai_migrator:marcai_migrator_dev@localhost:5432/marcai
# Aplicação: sem BYPASSRLS. Toda leitura de tenant passa por withTenant().
DATABASE_URL=postgres://marcai_app:marcai_app_dev@localhost:5432/marcai
# Testes de integração usam estes mesmos papéis num banco separado.
TEST_DATABASE_NAME=marcai_test

REDIS_URL=redis://localhost:6379

# Domínio raiz (com porta em dev). Tenants em {slug}.<raiz>, backoffice em admin.<raiz>.
# Em dev use marcai.localhost: *.localhost resolve sozinho e o cookie vale nos subdomínios.
NEXT_PUBLIC_ROOT_DOMAIN=marcai.localhost:3000

# --- Auth (Better Auth) ---------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=troque-isto
# Opcional: login com Google (sem estas, só e-mail mágico)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mostra /design em build de produção (usado pelos testes de acessibilidade)
# ENABLE_DESIGN_PAGE=1
